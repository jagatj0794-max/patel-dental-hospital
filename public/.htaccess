ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect www to the non-www canonical host
  RewriteCond %{HTTP_HOST} ^www\.pdhrajkot\.com$ [NC]
  RewriteRule ^(.*)$ https://pdhrajkot.com/$1 [R=301,L]

  # Original Legacy 301 Redirects
  RewriteRule ^services/single-sitting-root-canal-treatment/?$ /services/root-canal-treatment/ [R=301,L]
  RewriteRule ^services/crowns-and-bridges/?$ /services/crowns-bridges/ [R=301,L]
  RewriteRule ^blog/?$ /blogs/ [R=301,L]
  RewriteRule ^sameday/?$ /services/dental-implants/ [R=301,L]

  # New 301 Redirects (Gujarati)
  RewriteRule ^implants/?$ /services/dental-implants/ [R=301,L]
  RewriteRule ^(kids|pediatric|pediatric-dentistry)/?$ /services/pediatric-dentistry/ [R=301,L]
  RewriteRule ^braces/?$ /services/braces-treatment/ [R=301,L]
  RewriteRule ^academy/?$ /blogs/ [R=301,L]
  RewriteRule ^about/?$ /doctors/ [R=301,L]

  # New 301 Redirects (English /en/)
  RewriteRule ^en/implants/?$ /en/services/dental-implants/ [R=301,L]
  RewriteRule ^en/(kids|pediatric|pediatric-dentistry)/?$ /en/services/pediatric-dentistry/ [R=301,L]
  RewriteRule ^en/braces/?$ /en/services/braces-treatment/ [R=301,L]
  RewriteRule ^en/academy/?$ /en/blogs/ [R=301,L]
  RewriteRule ^en/about/?$ /en/doctors/ [R=301,L]
  RewriteRule ^en/blog/?$ /en/blogs/ [R=301,L]

  # 301 redirects for renamed image files
  RewriteRule ^1\,-1\.webp$ /1-1.webp [R=301,L]
  RewriteRule ^1730717115_Statue_of_Unity\.jpg$ /1730717115-statue-of-unity.jpg [R=301,L]
  RewriteRule ^2\,-1\.webp$ /2-1.webp [R=301,L]
  RewriteRule ^3\,-1\.webp$ /3-1.webp [R=301,L]
  RewriteRule ^4\,-1\.webp$ /4-1.webp [R=301,L]
  RewriteRule ^5\,-1\.webp$ /5-1.webp [R=301,L]
  RewriteRule ^Aligners\ svg\.svg$ /aligners-svg.svg [R=301,L]
  RewriteRule ^Best\ Dntal\ Hospital\ Rajkot\.PNG$ /best-dental-hospital-rajkot.png [R=301,L]
  RewriteRule ^Dental\ Implant\ svg\.svg$ /dental-implant-svg.svg [R=301,L]
  RewriteRule ^Dental\ Implants\.webp$ /dental-implants.webp [R=301,L]
  RewriteRule ^Digital\ Dental\ Experts\.webp$ /digital-dental-experts.webp [R=301,L]
  RewriteRule ^Dr\.\ Kinjal\ Patel\.JPG$ /dr-kinjal-patel.jpg [R=301,L]
  RewriteRule ^Dr\.\ Vipul\ Patel\.jpg$ /dr-vipul-patel.jpg [R=301,L]
  RewriteRule ^Full\ Mouth\.webp$ /full-mouth.webp [R=301,L]
  RewriteRule ^Gir-National-Park-and-Santuary\.jpg$ /gir-national-park-and-sanctuary.jpg [R=301,L]
  RewriteRule ^Great\ Rann\ Of\ Kutch\ \(14\)\.jpg$ /great-rann-of-kutch-14.jpg [R=301,L]
  RewriteRule ^IMG_20190521_190345\.jpg$ /img-20190521-190345.jpg [R=301,L]
  RewriteRule ^IMG_20200313_130221\.jpg$ /img-20200313-130221.jpg [R=301,L]
  RewriteRule ^IMG_3610\.webp$ /img-3610.webp [R=301,L]
  RewriteRule ^LOGO\ 3D\ FULL\ NAME\ WHITE\ \(3\)-1\.png$ /logo-3d-full-name-white-3-1.png [R=301,L]
  RewriteRule ^MG_3249\.webp$ /mg-3249.webp [R=301,L]
  RewriteRule ^Oral\ \&\ Maxillofacial\ Surgeries\ svg\.svg$ /oral-and-maxillofacial-surgeries-svg.svg [R=301,L]
  RewriteRule ^Oral\ \&\ Maxillofacial\ Surgery\.png$ /oral-and-maxillofacial-surgery.png [R=301,L]
  RewriteRule ^Root\ Canal\ Treatments\.svg\.svg$ /root-canal-treatments.svg [R=301,L]
  RewriteRule ^Root\ Canal\.webp$ /root-canal.webp [R=301,L]
  RewriteRule ^Smile\ Designing\.webp$ /smile-designing.webp [R=301,L]
  RewriteRule ^Teblate\ hero\ image-1\.webp$ /tablet-hero-image-1.webp [R=301,L]
  RewriteRule ^cline\ aliner\ in\ rajkot\.jpg$ /clear-aligner-in-rajkot.jpg [R=301,L]
  RewriteRule ^dental\ implant\ in\ rajkot\.jpg$ /dental-implant-in-rajkot.jpg [R=301,L]
  RewriteRule ^dr\.\ patel\.png$ /dr-patel.png [R=301,L]
  RewriteRule ^dr\.\ vipul\ patel\.webp$ /dr-vipul-patel.webp [R=301,L]
  RewriteRule ^sounds/notification\.wav\.mp3$ /sounds/notification.mp3 [R=301,L]
  RewriteRule ^white\ teeth\ in\ rajkot\.jpg$ /white-teeth-in-rajkot.jpg [R=301,L]

  # Optional Safety Net for Dynamic Client-Side SPA Routes (Admin & DB Tests)
  RewriteRule ^admin(/.*)?$ /index.html [L]
  RewriteRule ^admin-login/?$ /index.html [L]
  RewriteRule ^supabase-test/?$ /index.html [L]

  # Real 404 for any other missing file or directory
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . - [R=404,L]
</IfModule>

